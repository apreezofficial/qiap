<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- v1 is fully on-device: no INTERNET permission, by design.
         MediaPipe Tasks pulls in Google's datatransport library to upload usage stats, and that
         library's manifest requests network access. Strip it: without INTERNET the upload fails
         with an IOException that datatransport catches and retries later, so nothing is sent and
         nothing crashes. CI fails the build if INTERNET ever reappears. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Rep counting reads the front camera on-device. Frames never leave the phone. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Not required so the app (and its alarm) still installs on devices without one. -->
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:name=".QiapApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Qiap">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
